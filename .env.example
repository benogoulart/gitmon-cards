# Copie para .env.local e preencha. Nunca commite .env.local.

# --- Domínio base ---
# Sem hardcode de domínio em nenhum lugar do código (RFC 11): o destino é um
# subdomínio de scalabrin.dev, e a migração não pode virar retrabalho.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- GitHub ---
# Token de app no servidor (5.000 req/h). Escopo mínimo: leitura pública.
# O visitante nunca faz login (RFC 5).
GITHUB_TOKEN=

# --- Cache de dados (Redis / ioredis) ---
# Só os dados da API do GitHub. A imagem final NÃO passa por aqui — o cache dela
# é HTTP Cache-Control na CDN (RFC 4.2).
REDIS_URL=
CARD_DATA_TTL_SECONDS=3600

# --- Batalha ---
# TTL do resultado de batalha (battle-id). Um resultado já sorteado é imutável;
# o que se decide aqui é por quanto tempo o link compartilhado continua vivo.
BATTLE_TTL_SECONDS=2592000
